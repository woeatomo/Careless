# Careless bot (meridianEvPANDA architecture). No LLM or paid API key required.
RPC_URL=https://api.mainnet-beta.solana.com
# MONITOR_RPC_URL=
# BALANCE_RPC_URL=
# FALLBACK_RPC_URL=
# WALLET_ADDRESS=public_address_for_read_only_operation
# WALLET_PRIVATE_KEY=base58_secret_for_live_signing   # leave unset while testing in shadow/paper mode
DRY_RUN=true
# PNL_SOURCE=meteora
# PNL_RPC_URL=
# JUPITER_API_KEY=
# TELEGRAM_BOT_TOKEN=      # use a NEW bot token, not the one your meridian bot uses
# TELEGRAM_CHAT_ID=
# GMGN_API_KEY=            # optional; without it the GMGN filter is skipped
# JUPITER_REFERRAL_ACCOUNT= / JUPITER_REFERRAL_FEE_BPS=  # referral fee is off by default

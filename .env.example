# API key dari LP Agent Portal (https://portal.lpagent.io/)
LP_AGENT_API_KEY=

# Private key (base58) wallet agent LP Agent: Settings > Account > Export Private Key
# KOSONGKAN selama paper test (mode Lab) — baru diisi saat mau live.
# JANGAN commit file .env. Isi wallet ini hanya dengan modal LP secukupnya.
SOLANA_PRIVATE_KEY=

# Opsional: notifikasi + perintah lewat Telegram (/compare /status /approve /reject /pause /resume)
# Pakai bot Telegram BARU (token terpisah dari bot lain di VPS yang sama), supaya perintah tidak rebutan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsional: notifikasi ke Discord (satu arah)
DISCORD_WEBHOOK_URL=

# Opsional: lokasi config dan data
CONFIG_PATH=config/strategy.yaml
DATA_DIR=data
